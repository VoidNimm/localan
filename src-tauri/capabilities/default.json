{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Local Chat",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    "shell:allow-open",
    "shell:allow-kill",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:11434/*"
        },
        {
          "url": "http://127.0.0.1:7000/*"
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "start_rembg_bat",
          "cmd": "cmd",
          "args": [
            "/c",
            {
              "validator": ".*start_rembg\\.bat"
            }
          ],
          "sidecar": false
        },
        {
          "name": "run_rembg_python",
          "cmd": "python",
          "args": [
            {
              "validator": ".*run_rembg\\.py"
            },
            "--host",
            "127.0.0.1",
            "--port",
            "7000",
            "--vram-limit-mb",
            "2048",
            "--no-ui"
          ],
          "sidecar": false
        }
      ]
    }
  ]
}
